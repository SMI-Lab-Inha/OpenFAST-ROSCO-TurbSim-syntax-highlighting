{
  "name": "OpenFAST",
  "scopeName": "source.openfast",
  "fileTypes": [
    "fst",
    "dat",
    "in",
    "inp",
    "out",
    "ipt",
    "ech",
    "wnd",
    "sum",
    "bmi",
    "lin",
    "dvr"
  ],
  "patterns": [
    {
      "include": "#file-opening"
    },
    {
      "include": "#output-header-line"
    },
    {
      "include": "#comment-banners"
    },
    {
      "include": "#full-line-comments"
    },
    {
      "include": "#hash-comments"
    },
    {
      "include": "#section-banners"
    },
    {
      "include": "#end-marker"
    },
    {
      "include": "#units-rows"
    },
    {
      "include": "#table-rows"
    },
    {
      "include": "#quoted-special-values"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#special-values"
    },
    {
      "include": "#unquoted-values"
    },
    {
      "include": "#moordyn-keywords"
    },
    {
      "include": "#vtk-keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#parameter-names"
    },
    {
      "include": "#table-headers"
    },
    {
      "include": "#trailing-descriptions"
    },
    {
      "include": "#typed-annotations"
    },
    {
      "include": "#notes"
    },
    {
      "include": "#bang-comments"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "file-opening": {
      "patterns": [
        {
          "name": "markup.heading.openfast",
          "begin": "\\A(?![^\\S\\r\\n]*[A-Za-z][\\w()*/.\\-]*(?:(?:\\t|[^\\S\\r\\n]{2,})[A-Za-z][\\w()*/.\\-]*){3,}[^\\S\\r\\n]*$).*\\n?",
          "end": "^(?=[^\\S\\r\\n]*[A-Za-z][\\w()*/.\\-]*(?:(?:\\t|[^\\S\\r\\n]{2,})[A-Za-z][\\w()*/.\\-]*){3,}[^\\S\\r\\n]*$)|^.*$"
        }
      ]
    },
    "output-header-line": {
      "patterns": [
        {
          "name": "markup.heading.openfast",
          "match": "^\\s*(?:These predictions|Predictions|This summary information)\\s+(?:was|were)\\s+generated\\b.*$"
        },
        {
          "name": "markup.heading.openfast",
          "match": "^\\s*linked with\\b.*$"
        },
        {
          "name": "markup.heading.openfast",
          "match": "^\\s*[A-Za-z][A-Za-z0-9 ,;()/_?-]*:(?:\\s+[^\\t\\r\\n]*)?$"
        }
      ]
    },
    "comment-banners": {
      "patterns": [
        {
          "name": "markup.heading.openfast",
          "match": "^\\s*!\\s*(?:[-=]{3,}|\\.{5,}).*$"
        }
      ]
    },
    "full-line-comments": {
      "patterns": [
        {
          "name": "comment.line.bang.openfast",
          "match": "^\\s*!.*$"
        }
      ]
    },
    "hash-comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.openfast",
          "match": "^\\s*#.*$"
        }
      ]
    },
    "section-banners": {
      "patterns": [
        {
          "name": "markup.heading.openfast",
          "match": "^\\s*[-=]{3,}.*$"
        }
      ]
    },
    "end-marker": {
      "patterns": [
        {
          "match": "(?i)^(?:\\s{0,2})(END)\\b(.*)$",
          "captures": {
            "1": {
              "name": "keyword.control.end.openfast"
            },
            "2": {
              "name": "comment.line.end-remark.openfast"
            }
          }
        }
      ]
    },
    "table-rows": {
      "patterns": [
        {
          "name": "meta.table-row.openfast",
          "begin": "^(?=\\s*\\S+(?:\\s+\\S+){2,}\\s*$)(?!\\s*(?:[-=]{3}|!|#|END\\b))(?!.*\\s[-\\x{2013}]\\s+[^\\s\\d.+\\-])(?!.*\\s!)(?!.*[\\[\\]{}()])(?=(?:.*?(?<![\\w.^])[-+]?(?:\\d+\\.?\\d*|\\.\\d+)(?:[eEdD][-+]?\\d+)?(?![\\w.])){2})",
          "end": "$",
          "patterns": [
            {
              "include": "#quoted-special-values"
            },
            {
              "include": "#strings"
            },
            {
              "include": "#special-values"
            },
            {
              "include": "#moordyn-keywords"
            },
            {
              "include": "#numbers"
            },
            {
              "name": "constant.language.special-value.placeholder.openfast",
              "match": "(?<!\\S)-(?!\\S)"
            },
            {
              "name": "string.unquoted.value.openfast",
              "match": "(?<![\\w.+\\-])[A-Za-z_][\\w.+\\-#*]*"
            },
            {
              "include": "#punctuation"
            }
          ]
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.path.openfast",
          "begin": "@?\"(?![-+\\d.eEdD\\s,]*\")(?=(?:[A-Za-z]:\\\\|\\.\\.?/|[^\"\\r\\n]*[\\\\/][^\"\\r\\n]*|[^\"\\r\\n]*\\.[A-Za-z0-9]{1,8}))",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.openfast"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.openfast"
            }
          },
          "patterns": [
            {
              "name": "constant.language.special-value.openfast",
              "match": "(?i)\\b(?:default|unused|none)\\b"
            }
          ]
        },
        {
          "name": "string.quoted.double.openfast",
          "begin": "@?\"",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.openfast"
            }
          },
          "end": "\"|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.openfast"
            }
          },
          "patterns": [
            {
              "name": "constant.language.special-value.openfast",
              "match": "(?i)\\b(?:default|unused|none)\\b"
            }
          ]
        }
      ]
    },
    "quoted-special-values": {
      "patterns": [
        {
          "name": "constant.language.special-value.quoted.openfast",
          "match": "(?i)\"(?:default|unused|none|true|false)\""
        }
      ]
    },
    "inline-strings": {
      "patterns": [
        {
          "include": "#quoted-special-values"
        },
        {
          "name": "string.quoted.double.openfast",
          "match": "\"[^\"\\r\\n]*\""
        }
      ]
    },
    "special-values": {
      "patterns": [
        {
          "name": "constant.language.boolean.openfast",
          "match": "(?i)\\b(?:true|false)\\b"
        },
        {
          "name": "constant.language.special-value.openfast",
          "match": "(?i)\\b(?:default|unused|none)\\b"
        }
      ]
    },
    "moordyn-keywords": {
      "patterns": [
        {
          "name": "keyword.other.moordyn.openfast",
          "match": "(?i)\\b(?:Free|Fixed|Vessel|Coupled|Pinned)\\b"
        }
      ]
    },
    "vtk-keywords": {
      "patterns": [
        {
          "name": "keyword.other.vtk.openfast",
          "match": "\\b(?:WrVTK|VTK_type|VTK_fields|VTK_fps)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.openfast",
          "match": "(?<![\\w.])[-+]?(?:\\d+\\.\\d*|\\.\\d+|\\d+)(?:[eEdD][-+]?\\d+)?(?![\\w.])"
        }
      ]
    },
    "parameter-names": {
      "patterns": [
        {
          "name": "variable.parameter.openfast",
          "match": "(?<!\\S)[A-Za-z][A-Za-z0-9_]*(?:\\([^)]+\\))?(?=\\s+(?:[-\\x{2013}]\\s|!))"
        },
        {
          "name": "variable.parameter.openfast",
          "match": "(?<=!\\s)[A-Za-z][A-Za-z0-9_]*(?:\\([^)]+\\))?(?=\\s+[-\\x{2013}]\\s)"
        }
      ]
    },
    "table-headers": {
      "patterns": [
        {
          "name": "support.type.table-header.openfast",
          "match": "^(?=.*[A-Za-z])(?!(?:\\s*!|\\s*[-=]{3,}|\\s{0,2}END\\b))\\s*(?:[A-Za-z][A-Za-z0-9_/.*-]*(?:\\([^)]+\\))?\\s+){1,}[A-Za-z][A-Za-z0-9_/.*-]*(?:\\([^)]+\\))?\\s*$"
        },
        {
          "name": "support.type.table-header.openfast",
          "match": "^(?=.*[A-Za-z])(?!(?:\\s*!|\\s*[-=]{3,}|\\s{0,2}END\\b))\\s*(?:[A-Za-z][A-Za-z0-9_/.*-]*(?:\\([^)]+\\))?\\s+){2,}[A-Za-z][A-Za-z0-9_/.*-]*(?:\\([^)]+\\))?(?=\\s*(?:!|\\[))"
        }
      ]
    },
    "units-rows": {
      "patterns": [
        {
          "name": "meta.annotation.units.openfast",
          "begin": "^(?=\\s*(?:(?:\\([^()\\r\\n]+\\)|\\[[^\\[\\]\\r\\n]+\\])\\s*){2,}$)",
          "end": "$",
          "patterns": [
            {
              "name": "keyword.other.unit.openfast",
              "match": "\\([^()\\r\\n]+\\)|\\[[^\\[\\]\\r\\n]+\\]"
            }
          ]
        }
      ]
    },
    "units": {
      "patterns": [
        {
          "name": "keyword.other.unit.openfast",
          "match": "(?<![\\w)\\]])(?:\\(\\s*(?:1/)?(?:[kMG]?(?:N-m|Nm|N|W|J|Pa|Hz)|seconds?|sec\\.?|s|degrees?|deg|radians?|rad|rpm|meters?|mm|cm|km|m|kg|tonnes?|min|hrs?|ohms?|volts?|%|-)(?:\\^-?\\d+)?(?:(?:[/*\\-]|\\s|,\\s*)(?:1/)?(?:[kMG]?(?:N-m|Nm|N|W|J|Pa|Hz)|seconds?|sec\\.?|s|degrees?|deg|radians?|rad|rpm|meters?|mm|cm|km|m|kg|tonnes?|min|hrs?|ohms?|volts?|%|-)(?:\\^-?\\d+)?)*\\s*\\)|\\[\\s*(?:1/)?(?:[kMG]?(?:N-m|Nm|N|W|J|Pa|Hz)|seconds?|sec\\.?|s|degrees?|deg|radians?|rad|rpm|meters?|mm|cm|km|m|kg|tonnes?|min|hrs?|ohms?|volts?|%|-)(?:\\^-?\\d+)?(?:(?:[/*\\-]|\\s|,\\s*)(?:1/)?(?:[kMG]?(?:N-m|Nm|N|W|J|Pa|Hz)|seconds?|sec\\.?|s|degrees?|deg|radians?|rad|rpm|meters?|mm|cm|km|m|kg|tonnes?|min|hrs?|ohms?|volts?|%|-)(?:\\^-?\\d+)?)*\\s*\\])"
        }
      ]
    },
    "trailing-descriptions": {
      "patterns": [
        {
          "name": "comment.line.description.openfast",
          "begin": "(?<=\\s)[-\\x{2013}]\\s(?=[^\\[{(])",
          "end": "$",
          "patterns": [
            {
              "include": "#description-content"
            }
          ]
        }
      ]
    },
    "description-content": {
      "patterns": [
        {
          "include": "#typed-annotations"
        },
        {
          "include": "#units"
        },
        {
          "include": "#inline-strings"
        },
        {
          "include": "#option-item"
        },
        {
          "include": "#available-options"
        }
      ]
    },
    "typed-annotations": {
      "patterns": [
        {
          "name": "storage.type.annotation.openfast",
          "match": "(?i)[(\\[](?:flag|switch|string|quoted strings?|integer|real|logical|array)[)\\]]"
        }
      ]
    },
    "option-item": {
      "comment": "A key/label pair in an option list: `0=none`, `1: RK4`, `2- WSE TSR Tracking`, `T: timed`. The label must contain a letter so ranges like `0 - 9` are left alone.",
      "patterns": [
        {
          "match": "(?<=[{\\[(,;=]|[-\\x{2013}]\\s)\\s*([-+]?\\d+(?:\\.\\d+)?(?:[A-Za-z]#?)?|(?i:true|false|default)|[TF])\\s*(:|=|-(?![\\d.]))\\s*(?=[^,;{}\\[\\]()\\r\\n]*[A-Za-z])([^,;{}\\[\\]()\\r\\n]*[^,;{}\\[\\]()\\s])",
          "captures": {
            "1": {
              "patterns": [
                {
                  "include": "#special-values"
                },
                {
                  "include": "#numbers"
                },
                {
                  "name": "constant.other.option.key.openfast",
                  "match": ".+"
                }
              ]
            },
            "2": {
              "name": "punctuation.separator.key-value.openfast"
            },
            "3": {
              "name": "constant.other.option.openfast"
            }
          }
        }
      ]
    },
    "option-condition": {
      "comment": "A reference to another input inside a note, e.g. `PCMode=0`, `NumBl < 3`, `UAMod<>1`. The name must contain an uppercase letter so prose like `be <= 99` is not matched.",
      "patterns": [
        {
          "match": "(?<![\\w.])((?=[A-Za-z0-9_]*[A-Z])[A-Za-z][A-Za-z0-9_]*(?:\\([^)]*\\))?)\\s*(==|/=|>=|<=|<>|=|>|<)",
          "captures": {
            "1": {
              "name": "variable.parameter.reference.openfast"
            },
            "2": {
              "name": "keyword.operator.comparison.openfast"
            }
          }
        }
      ]
    },
    "option-content": {
      "patterns": [
        {
          "include": "#inline-strings"
        },
        {
          "include": "#typed-annotations"
        },
        {
          "include": "#units"
        },
        {
          "include": "#option-item"
        },
        {
          "include": "#option-condition"
        },
        {
          "include": "#special-values"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#available-options"
        },
        {
          "include": "#option-operators"
        }
      ]
    },
    "paren-content": {
      "comment": "Parentheses in descriptions are mostly prose, so only structured pieces are picked out; bare numbers are left as description text.",
      "patterns": [
        {
          "include": "#inline-strings"
        },
        {
          "include": "#typed-annotations"
        },
        {
          "include": "#units"
        },
        {
          "include": "#option-item"
        },
        {
          "include": "#option-condition"
        },
        {
          "include": "#available-options"
        },
        {
          "include": "#option-operators"
        }
      ]
    },
    "option-operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.openfast",
          "match": "==|/=|>=|<=|<>|=|>|<"
        },
        {
          "name": "punctuation.separator.sequence.openfast",
          "match": "[;,:]"
        }
      ]
    },
    "available-options": {
      "patterns": [
        {
          "name": "meta.braces.options.openfast",
          "begin": "\\{",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.braces.begin.openfast"
            }
          },
          "end": "\\}|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.braces.end.openfast"
            }
          },
          "patterns": [
            {
              "include": "#option-content"
            }
          ]
        },
        {
          "name": "meta.brackets.options.openfast",
          "begin": "\\[",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.brackets.begin.openfast"
            }
          },
          "end": "\\]|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.brackets.end.openfast"
            }
          },
          "patterns": [
            {
              "include": "#option-content"
            }
          ]
        },
        {
          "name": "meta.parens.options.openfast",
          "begin": "\\(",
          "beginCaptures": {
            "0": {
              "name": "punctuation.section.parens.begin.openfast"
            }
          },
          "end": "\\)|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.parens.end.openfast"
            }
          },
          "patterns": [
            {
              "include": "#paren-content"
            }
          ]
        }
      ]
    },
    "notes": {
      "comment": "A [...] or {...} group outside a description (after a table header, for example). Its prose reads as a comment while option keys and references keep their colors.",
      "patterns": [
        {
          "name": "comment.line.note.openfast",
          "begin": "(?=[\\[{])",
          "end": "(?<=[\\]}])|$",
          "patterns": [
            {
              "include": "#available-options"
            }
          ]
        }
      ]
    },
    "bang-comments": {
      "patterns": [
        {
          "begin": "(?<=\\s)(!)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.comment.openfast"
            }
          },
          "end": "$",
          "patterns": [
            {
              "match": "\\G\\s*([A-Za-z][A-Za-z0-9_]*(?:\\([^)]+\\))?)(?=\\s+[-\\x{2013}]\\s)",
              "captures": {
                "1": {
                  "name": "variable.parameter.openfast"
                }
              }
            },
            {
              "include": "#trailing-descriptions"
            },
            {
              "name": "comment.line.bang.openfast",
              "begin": "(?=\\S)",
              "end": "$",
              "patterns": [
                {
                  "include": "#description-content"
                }
              ]
            }
          ]
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.section.braces.openfast",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.openfast",
          "match": "[\\[\\]]"
        },
        {
          "name": "punctuation.section.parens.openfast",
          "match": "[()]"
        },
        {
          "name": "punctuation.separator.sequence.openfast",
          "match": "[,;]"
        }
      ]
    },
    "unquoted-values": {
      "patterns": [
        {
          "name": "string.unquoted.value.openfast",
          "match": "^\\s*[A-Za-z][A-Za-z0-9_.+]*(?=\\s+[A-Za-z][A-Za-z0-9_]*(?:\\([^)]+\\))?\\s+(?:[-\\x{2013}]\\s|!))"
        }
      ]
    }
  }
}
